datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

////////////////////////////////
// USER & ROLE
////////////////////////////////

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  buffetSessions BuffetSession[] @relation("CashierSessions")
}

enum Role {
  ADMIN
  KITCHEN
  CASHIER
}

////////////////////////////////
// TABLE
////////////////////////////////

model Table {
  id     Int         @id @default(autoincrement())
  number Int         @unique
  status TableStatus @default(EMPTY)

  buffetSessions BuffetSession[]
}

enum TableStatus {
  EMPTY
  OPEN
}

////////////////////////////////
// BUFFET PACKAGE
////////////////////////////////

model BuffetPackage {
  id        Int    @id @default(autoincrement())
  name      String // เช่น 299 / 399
  price     Float
  timeLimit Int // นาที

  sessionPackages SessionPackage[]
}

////////////////////////////////
// BUFFET SESSION (1 โต๊ะ / 1 รอบ)
////////////////////////////////

model BuffetSession {
  id     Int          @id @default(autoincrement())
  status BuffetStatus @default(ACTIVE)

  tableId Int
  table   Table @relation(fields: [tableId], references: [id])

  cashierId Int
  cashier   User @relation("CashierSessions", fields: [cashierId], references: [id])

  startTime DateTime  @default(now())
  endTime   DateTime?

  packages SessionPackage[]
  orders   Order[]
  bill     Bill?
}

enum BuffetStatus {
  ACTIVE
  FINISHED
}

////////////////////////////////
// SESSION PACKAGE (หลายแพ็กเกจในโต๊ะเดียว)
////////////////////////////////

model SessionPackage {
  id        Int @id @default(autoincrement())
  sessionId Int
  packageId Int
  qty       Int

  session BuffetSession @relation(fields: [sessionId], references: [id])
  package BuffetPackage @relation(fields: [packageId], references: [id])
}

////////////////////////////////
// CATEGORY & MENU
////////////////////////////////

model Category {
  id    Int     @id @default(autoincrement())
  name  String
  image String?

  menus Menu[]
}

model Menu {
  id         Int      @id @default(autoincrement())
  name       String
  price      Float? // บุฟเฟต์อาจไม่ใช้
  image      String?
  categoryId Int
  createdAt  DateTime @default(now())

  category Category    @relation(fields: [categoryId], references: [id])
  items    OrderItem[]
}

////////////////////////////////
// ORDER (สั่งอาหาร)
////////////////////////////////

model Order {
  id              Int         @id @default(autoincrement())
  buffetSessionId Int
  status          OrderStatus @default(PENDING)
  createdAt       DateTime    @default(now())

  buffetSession BuffetSession @relation(fields: [buffetSessionId], references: [id])
  items         OrderItem[]
}

model OrderItem {
  id      Int @id @default(autoincrement())
  orderId Int
  menuId  Int
  qty     Int

  order Order @relation(fields: [orderId], references: [id])
  menu  Menu  @relation(fields: [menuId], references: [id])
}

////////////////////////////////
// BILL (ชำระเงิน)
////////////////////////////////

model Bill {
  id          Int         @id @default(autoincrement())
  sessionId   Int         @unique
  totalPrice  Int
  paidAmount  Int
  paymentType PaymentType
  createdAt   DateTime    @default(now())

  session BuffetSession @relation(fields: [sessionId], references: [id])
}

enum PaymentType {
  CASH
  QR
  CARD
}

enum OrderStatus {
  PENDING
  COOKING
  DONE
}
